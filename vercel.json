{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/fact.ts": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    { "source": "/api/fact", "destination": "/api/fact" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
