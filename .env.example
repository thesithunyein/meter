# MeterRegistry contract address on Arc Mainnet
VITE_METER_REGISTRY_ADDRESS=0x423B8701Da3a251a3A3fc2d241b71e8d05744C91

# Demo endpoint ID registered in the contract (used by /api/fact)
DEMO_ENDPOINT_ID=1

# Arc Studio RPC proxy — set automatically when running inside Arc Studio
# Leave unset when running outside Arc Studio; the app falls back to public RPC
RPC_PROXY_BASE_URL=
RPC_PROXY_TOKEN=
RPC_PROXY_CHAINS=
